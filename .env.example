# Copy to .env and adjust. Docker Compose and the Makefile read it automatically.

# Port published on the host and used inside the container (they must match).
PORT=8030

# Address the port is published on. 127.0.0.1 = this machine only; 0.0.0.0 = public.
BIND_ADDRESS=127.0.0.1

# Extra Host headers to accept, comma-separated, including the port,
# e.g. 203.0.113.5:8030,fonts.example.com
FONT_DESK_ALLOWED_HOSTS=
